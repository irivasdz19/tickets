# Servidor
PORT=3000
APP_NAME="API de Tickets - Entorno Local"

# Base de Datos
# Reemplazar <usuario> y <password> por las credenciales de MongoDB Atlas o usar localhost
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster-tickets.mongodb.net/ticketdb?retryWrites=true&w=majority

# Autenticación
# Ejecutar `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` para generar uno seguro
JWT_SECRET=reemplazar_por_un_hash_seguro_en_produccion